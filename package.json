{
  "name": "har-auto-analyzer",
  "displayName": "HAR Auto Analyzer",
  "description": "Open and analyze HAR files natively",
  "version": "0.0.21",
  "publisher": "yeceen",
  "homepage": "https://github.com/ceendev/har-auto-analyzer",
  "license": "GPL-3",
  "repository": {
    "type": "git",
    "url": "https://github.com/ceendev/har-auto-analyzer"
  },
  "bugs": {
    "url": "https://github.com/ceendev/har-auto-analyzer/issues"
  },
  "icon": "Icon.png",
  "engines": {
    "vscode": "^1.67.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:har-auto-analyzer.analyze",
    "onCustomEditor:har-auto-analyzer.editor"
  ],
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "har-auto-analyzer.editor",
        "displayName": "HAR Auto Analyzer",
        "selector": [
          {
            "filenamePattern": "*.har"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "title": "Analyze",
        "command": "har-auto-analyzer.analyze",
        "category": "Har Auto Analyzer"
      }
    ]
  },
  "scripts": {
    "check": "node --check extension.js && node --check media/script.js && node test/custom-editor.test.js && node test/har-entry.test.js && node test/filter-behavior.test.js",
    "lint": "eslint .",
    "package": "vsce package --out har-auto-analyzer.vsix",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^7.2.0",
    "@types/mocha": "^9.1.1",
    "@types/node": "14.x",
    "@types/vscode": "^1.67.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "3.9.2",
    "eslint": "^8.14.0",
    "glob": "^8.0.1",
    "mocha": "^9.2.2",
    "typescript": "^4.6.4"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.32"
  }
}
