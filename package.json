{
  "name": "har-editor",
  "displayName": "Har Editor",
  "description": "A visual HAR workspace for VS Code with automatic file opening, fast request filtering, resizable tables, and split request/response inspection.",
  "version": "0.1.3",
  "publisher": "yeceen",
  "homepage": "https://github.com/ceendev/har-editor",
  "license": "GPL-3",
  "repository": {
    "type": "git",
    "url": "https://github.com/ceendev/har-editor"
  },
  "bugs": {
    "url": "https://github.com/ceendev/har-editor/issues"
  },
  "icon": "resources/har-editor-icon.png",
  "engines": {
    "vscode": "^1.67.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "har",
    "http archive",
    "network",
    "http",
    "websocket",
    "request",
    "response",
    "viewer",
    "editor"
  ],
  "activationEvents": [
    "onCommand:har-editor.open",
    "onCustomEditor:har-editor.editor"
  ],
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "har-editor.editor",
        "displayName": "Har Editor",
        "selector": [
          {
            "filenamePattern": "*.har"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "title": "Open HAR File",
        "command": "har-editor.open",
        "category": "Har Editor"
      }
    ]
  },
  "scripts": {
    "check": "node --check extension.js && node --check media/script.js && node test/custom-editor.test.js && node test/har-entry.test.js && node test/filter-behavior.test.js",
    "lint": "eslint .",
    "package": "vsce package --out har-editor.vsix",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^7.2.0",
    "@types/mocha": "^9.1.1",
    "@types/node": "14.x",
    "@types/vscode": "^1.67.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "3.9.2",
    "eslint": "^8.14.0",
    "glob": "^8.0.1",
    "mocha": "^9.2.2",
    "typescript": "^4.6.4"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.32"
  }
}
